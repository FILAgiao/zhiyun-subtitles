# Copy to /etc/zhiyun-gateway.env, fill on the server, chmod 600.
ARK_API_KEY=
SPEECH_API_KEY=
# Streaming 2.0 key stays on the server. Empty falls back to SPEECH_API_KEY.
SPEECH_STREAM_API_KEY=
SPEECH_STREAM_RESOURCE_ID=volc.seedasr.sauc.duration
SPEECH_STREAM_ENABLED=1
ARK_MODELS=doubao-seed-translation-250915,doubao-seed-2-1-lite-260915
ARK_LEARNING_MODEL=doubao-seed-2-1-lite-260915
ALLOW_WEB_SEARCH=0
# Comma-separated origins; set the actual extension ID before release.
ALLOWED_ORIGINS=chrome-extension://REPLACE_EXTENSION_ID
DATABASE_PATH=/var/lib/zhiyun-gateway/gateway.sqlite3
PORT=8080

# Browser dashboard origin (scheme + host only, no /gateway path)
PUBLIC_ORIGIN=https://your-domain.example

# Guest speech allowance per IP per UTC month; AI still requires login.
GUEST_SPEECH_REQUESTS=120
GUEST_SPEECH_SECONDS=1440

# Accept Chrome / Edge extension origins; user authentication remains mandatory for AI.
ALLOW_EXTENSION_ORIGINS=1

# Optional email registration; leave unset until the sending service is ready.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls
