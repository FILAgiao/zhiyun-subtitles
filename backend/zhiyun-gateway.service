[Unit]
Description=Shared application API gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zhiyun-gateway
Group=zhiyun-gateway
WorkingDirectory=/opt/zhiyun-gateway
EnvironmentFile=/etc/zhiyun-gateway.env
ExecStart=/usr/bin/python3 /opt/zhiyun-gateway/backend/server.py serve
Restart=on-failure
RestartSec=3
StateDirectory=zhiyun-gateway
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zhiyun-gateway

[Install]
WantedBy=multi-user.target
