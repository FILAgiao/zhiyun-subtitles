+PROFILE_TEXT_FIELDS = frozenset({
+    "publication_label", "publication_scope", "publication_note", "quote_label",
+})
+PROFILE_FIELDS = PROFILE_TEXT_FIELDS | {"show_follow_cta"}
+
+
+def load_article_profile(path):
+    """Load only optional article labels and the footer switch, never CSS."""
+    if path is None:
+        return {}
+    try:
+        profile = json.loads(Path(path).read_text(encoding="utf-8-sig"))
+    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
+        raise RenderError(f"文章 profile JSON 读取失败：{exc}") from exc
+    if not isinstance(profile, dict):
+        raise RenderError("文章 profile JSON 必须是对象")
+    unknown = sorted(set(profile) - PROFILE_FIELDS)
+    if unknown:
+        raise RenderError(f"文章 profile 包含未知字段：{', '.join(unknown)}")
+    for key, value in profile.items():
+        if key == "show_follow_cta":
+            if type(value) is not bool:
+                raise RenderError("文章 profile 的 show_follow_cta 必须是布尔值")
+        elif not isinstance(value, str):
+            raise RenderError(f"文章 profile 的 {key} 必须是纯文本字符串")
+        elif re.search(r"<[^>]*>|[\x00-\x1f\x7f]", value):
+            raise RenderError(f"文章 profile 的 {key} 不能包含 HTML 标记或控制字符")
+    return profile
+
